# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings > API). Never commit the real values,
# and never put the service role key in a NEXT_PUBLIC_* variable or in any
# code that runs in the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the redirect link inside password-reset emails
# (e.g. https://farmbuddy.app in production). Falls back to the request's
# own host if unset, so it's optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Added here as a placeholder for Phase 2 (Supabase schema +
# RLS + Storage); do not expose this to the client or prefix it with
# NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
